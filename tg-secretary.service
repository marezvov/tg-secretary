[Unit]
Description=Personal AI Secretary Telegram Bot
After=network-online.target <YOUR_LLM_SERVICE>.service
Wants=network-online.target <YOUR_LLM_SERVICE>.service

[Service]
Type=simple
User=<YOUR_USER>
WorkingDirectory=/home/<YOUR_USER>/tg-secretary
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/<YOUR_USER>/tg-secretary/.venv/bin/python -m app.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
