# Telegram
BOT_TOKEN=
# OpenAI-compatible local server (llama.cpp, vLLM, LM Studio, Ollama /v1, etc.)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL_NAME=local-model
LLM_API_KEY=sk-local

# Optional: pre-assign the owner. Without it, the first /start claims the bot.
ADMIN_ID=

# Storage and runtime
DB_PATH=data/secretary.db
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Europe/Moscow

# rtcwake is dangerous while testing: true only logs the command
POWER_DRY_RUN=true
